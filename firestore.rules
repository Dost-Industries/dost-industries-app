rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId;
    }

    function hasSaveCalculationsEntitlement(userId) {
      return isOwner(userId)
        && get(
          /databases/$(database)/documents/users/$(userId)
        ).data.entitlements.hasAny([
          "save-calculations"
        ]);
    }

    function hasValidUserFields() {
      return request.resource.data.keys().hasAll([
        "uid",
        "name",
        "email",
        "role",
        "entitlements",
        "subscription",
        "companyId",
        "createdAt"
      ])
      && request.resource.data.keys().hasOnly([
        "uid",
        "name",
        "email",
        "role",
        "entitlements",
        "subscription",
        "companyId",
        "createdAt"
      ]);
    }

    function hasValidUserValues(userId) {
      return request.resource.data.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "USER"
        && request.resource.data.entitlements == []
        && request.resource.data.subscription == null
        && request.resource.data.companyId == null
        && request.resource.data.createdAt == request.time;
    }

    function hasValidUserTypes() {
      return request.resource.data.uid is string
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 3
        && request.resource.data.email.size() <= 320
        && request.resource.data.role is string
        && request.resource.data.entitlements is list
        && request.resource.data.entitlements.size() == 0;
    }

    function hasValidCalculationFields() {
      return request.resource.data.keys().hasAll([
        "moduleId",
        "inputs",
        "result",
        "createdAt",
        "updatedAt"
      ])
      && request.resource.data.keys().hasOnly([
        "moduleId",
        "inputs",
        "result",
        "createdAt",
        "updatedAt"
      ]);
    }

    function hasValidCalculationValues() {
      return request.resource.data.moduleId is string
        && request.resource.data.moduleId.size() >= 1
        && request.resource.data.moduleId.size() <= 100
        && request.resource.data.inputs is map
        && request.resource.data.result is map
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
                    && hasValidUserFields()
                    && hasValidUserValues(userId)
                    && hasValidUserTypes();

      allow update: if false;

      allow delete: if isOwner(userId);

      match /calculations/{calculationId} {
        allow read: if hasSaveCalculationsEntitlement(userId);

        allow create: if hasSaveCalculationsEntitlement(userId)
                      && hasValidCalculationFields()
                      && hasValidCalculationValues();

        allow update: if false;

        allow delete: if hasSaveCalculationsEntitlement(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}