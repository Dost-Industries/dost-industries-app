rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId;
    }

    function hasValidUserFields() {
      return request.resource.data.keys().hasAll([
          "uid",
          "name",
          "email",
          "plan",
          "role",
          "modules",
          "companyId",
          "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "uid",
          "name",
          "email",
          "plan",
          "role",
          "modules",
          "companyId",
          "createdAt"
        ]);
    }

    function hasValidUserValues(userId) {
      return request.resource.data.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.plan == "FREE"
        && request.resource.data.role == "USER"
        && request.resource.data.modules == ["heat-input"]
        && request.resource.data.companyId == null
        && request.resource.data.createdAt == request.time;
    }

    function hasValidUserTypes() {
      return request.resource.data.uid is string
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 3
        && request.resource.data.email.size() <= 320
        && request.resource.data.plan is string
        && request.resource.data.role is string
        && request.resource.data.modules is list
        && request.resource.data.modules.size() == 1;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
                    && hasValidUserFields()
                    && hasValidUserValues(userId)
                    && hasValidUserTypes();

      allow update: if false;

      allow delete: if isOwner(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}